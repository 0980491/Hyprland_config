// fastfetch, dressed up as nitch. Generated by matugen from the wallpaper —
// edit ~/.config/matugen/templates/fastfetch.jsonc, not the output file.
//
// The ASCII art is NOT in here: it lives in ~/.config/fastfetch/logo.txt and is
// never overwritten, so that file is the one to edit to change the logo.
//
// The little icons are the "\uXXXX" escapes in the keys below — Nerd Font
// glyphs, same ones nitch used. Pick others at https://nerdfonts.com/cheat-sheet
// and paste the code point in. They are written as escapes rather than as the
// glyph itself so this file stays plain ASCII and cannot get mangled.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/logo.txt",
    "color": { "1": "#a4c9fe" },
    "padding": { "top": 1, "left": 1, "right": 3 }
  },

  "display": {
    "separator": "│ ",
    "color": {
      "output": "#e1e2e9",
      "separator": "#8d9199"
    }
  },

  // The box is drawn by hand: the left "|" and the trailing padding are part of
  // every key, the right "|" is the separator. Every key is padded to the same
  // 12 columns, and the box lines are 13 wide, so the right edge stays straight.
  // Change a label and you have to re-pad that key.
  "modules": [
    { "type": "custom", "format": "╭───────────╮", "outputColor": "#8d9199" },

    { "type": "title",    "key": "│ \uf007  user   ", "keyColor": "#a4c9fe",   "format": "{user-name}" },
    { "type": "title",    "key": "│ \ue714  hname  ", "keyColor": "#d9bde3",  "format": "{host-name}" },
    { "type": "os",       "key": "│ \uf83c  distro ", "keyColor": "#a4c9fe",   "format": "{name}" },
    { "type": "kernel",   "key": "│ \uf824  kernel ", "keyColor": "#bcc7db", "format": "{release}" },
    { "type": "uptime",   "key": "│ \uf017  uptime ", "keyColor": "#d9bde3" },
    { "type": "shell",    "key": "│ \uf489  shell  ", "keyColor": "#a4c9fe",   "format": "{pretty-name} {version}" },
    { "type": "packages", "key": "│ \uf8d5  pkgs   ", "keyColor": "#bcc7db", "format": "{all}" },
    { "type": "memory",   "key": "│ \uf85a  memory ", "keyColor": "#d9bde3" },

    { "type": "custom", "format": "├───────────┤", "outputColor": "#8d9199" },

    { "type": "colors",   "key": "│ \uf8d7  colors ", "keyColor": "#a4c9fe", "symbol": "circle" },

    { "type": "custom", "format": "╰───────────╯", "outputColor": "#8d9199" }
  ]
}
